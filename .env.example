# Environment Variables for ADHD Tracker PWA
# Copy this file to .env and fill in your values.
# The app works FULLY OFFLINE without any of these — they're all optional.

# ── Gemini AI Proxy (Cloudflare Worker) ─────────────────────────────────
# Deploy cloudflare-worker/index.js and paste the Worker URL here.
# Without this, all AI features (Brain Dump organize, task decompose) are disabled.
VITE_GEMINI_PROXY_URL=https://your-worker.your-subdomain.workers.dev

# ── Supabase (Cloud Sync) ─────────────────────────────────────────────────
# Without this, all data is saved to LocalStorage (offline-first).
# Get these from: https://app.supabase.com/ > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
